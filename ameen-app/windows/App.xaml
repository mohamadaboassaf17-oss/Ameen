<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ameen.Windows.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#1A73E8</Color>
            <Color x:Key="BackgroundColor">#0F0F0F</Color>
            <Color x:Key="SurfaceColor">#1E1E1E</Color>
            <Color x:Key="TextPrimary">#E8EAED</Color>
            <Color x:Key="TextSecondary">#9AA0A6</Color>
            <Color x:Key="ErrorColor">#F28B82</Color>
            <Color x:Key="SuccessColor">#81C995</Color>
            <Color x:Key="SecondaryColor">#8AB4F8</Color>
            <Color x:Key="SecondaryContainerColor">#1A2A3A</Color>
            <Color x:Key="PrimaryContainerColor">#E8F5E9</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
