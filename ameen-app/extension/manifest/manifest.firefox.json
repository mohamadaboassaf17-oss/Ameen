{
  "manifest_version": 3,
  "name": "أمين — Ameen",
  "version": "1.0.0",
  "description": "مدير كلمات مرور محلي وآمن — إضافة متصفح للتعبئة التلقائية",
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["127.0.0.1:*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "أمين",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_ui": {
    "page": "popup/settings.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ameen@ameen.local",
      "strict_min_version": "109.0"
    }
  }
}
